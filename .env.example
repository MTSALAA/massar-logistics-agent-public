# Copy to .env and adjust. Never commit .env.

# Where the agent stores its SQLite data (inside the container, a volume is mounted here).
DATABASE_PATH=/data/agent.db

# Base URL of the platform core, as seen from the agent container (publish shipments, pull orders and stock).
# Docker Compose reads this file: change the port here if your core is not on 8000.
CORE_URL=http://host.docker.internal:8000

# Road network for route planning. Leave empty to use straight-line estimates (distances x 1.3).
# After `scripts/prepare_osrm.ps1` (or .sh), set OSRM_URL=http://osrm:5000 and COMPOSE_PROFILES=routing,
# then `docker compose up -d` starts the routing service too.
OSRM_URL=
COMPOSE_PROFILES=
# Host port of the routing service, only for trying it by hand (the agent reaches it over the Docker network).
# Change it if port 5000 is taken on your computer.
OSRM_PORT=5000

# Geocoding of text addresses (Nominatim). Empty value switches it off.
# The policy asks for an identifying contact: put the team's address here.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=
NOMINATIM_COUNTRY=dz

# Seconds between two housekeeping passes (delay alerts, retries towards the core). 0 switches it off.
MAINTENANCE_SECONDS=300

# Key that signs sign-in cookies. Empty: a random key is created once and kept in the data volume.
SESSION_SECRET=
# Set to 1 when an HTTPS proxy sits in front of the agent, so the sign-in cookie is marked Secure.
SESSION_COOKIE_SECURE=
