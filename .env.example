# Copy to .env and fill in. Never commit .env.
# Where the agent stores its SQLite data (inside the container, a volume is mounted here).
DATABASE_PATH=/data/agent.db

# Base URL of the platform core, as seen from the agent container (publish shipments, pull orders and stock).
# Docker Compose reads this file: change the port here if your core is not on 8000.
CORE_URL=http://host.docker.internal:8000

# Road network for route planning. Leave empty to use straight-line distances.
# With `docker compose --profile routing up -d` (after scripts/prepare_osrm) use http://osrm:5000
OSRM_URL=

# Geocoding of text addresses (Nominatim). Empty value switches it off.
# The policy asks for an identifying contact: put the team's address here.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=
NOMINATIM_COUNTRY=dz
